# SPDX-License-Identifier: Apache-2.0
# clang-format style for the Alp SDK.
#
# Alp SDK is its OWN code style -- a unification layer across hardware and
# software platforms (Zephyr-on-M, Yocto/Linux-on-A, vendor SDKs), NOT a Zephyr
# project -- so this is the house style, not a mirror of any one platform.
# Indentation is TABS (each developer renders them at their preferred width;
# TabWidth below only feeds clang-format's column math).  Alignment stays in
# spaces ("smart tabs"), so columns line up regardless of tab width.
#
# The gate in THIS repo is the `clang-format` job in .github/workflows/ci.yml.
# It is DIFF-ONLY: it checks the .c/.h files a pull request actually touches,
# never the whole tree.  There is no path-based exclusion list here -- the
# vendor-shaped sources (the TI-derived startup in ti/, the SimpleLink-facing
# HAL under hal/ti/) are simply not looked at until a change touches them,
# because a tree-wide reformat would bury a real review in noise.
---
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: ForIndentation
ColumnLimit: 100
# Alignment: keep the polished column look for enums/structs/#define tables, but
# use Consecutive (resets at blank lines) rather than AcrossEmptyLines so editing
# one block never reflows its neighbours (avoids the "enum-alignment trap").
# AlignConsecutiveMacros lines up #define value columns (register/capability blocks).
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveMacros: Consecutive
AlignTrailingComments: true
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: WithoutElse
BreakBeforeBraces: Linux
# Wrapping: when a call/declaration is too long for the column limit, put each
# argument/parameter on its own line (one-per-line) rather than bin-packing them,
# so long public-API signatures + designated initialisers read clearly.
BinPackParameters: false
BinPackArguments: false
# LLVM's AllowAllParametersOfDeclarationOnNextLine defaults to true, which lets
# clang-format put every parameter of a wrapped declaration on a single
# continuation line despite BinPackParameters: false above.  That silently
# undoes the one-per-line intent for declarations (arguments at call sites are
# unaffected -- AllowAllArgumentsOnNextLine stays true; disabling it produced
# awkward call-site wrapping).  Set explicit false so a wrapped declaration
# always reads one aligned parameter per line, and adding a parameter later
# doesn't reshape an already-wrapped signature.
AllowAllParametersOfDeclarationOnNextLine: false
AllowAllArgumentsOnNextLine: true
KeepEmptyLinesAtTheStartOfBlocks: false
PointerAlignment: Right
SortIncludes: Never
SpaceAfterCStyleCast: false
SpacesInParentheses: false
SpacesInSquareBrackets: false
IncludeBlocks: Preserve
ReflowComments: false
# LLVM's default (Right) pads multi-line macro continuations with spaces up to
# ColumnLimit so every trailing `\` lines up in one column.  That inserts a lot
# of unrelated whitespace churn whenever a continuation line's length changes.
# DontAlign puts the `\` directly after the line's content instead.
AlignEscapedNewlines: DontAlign

# Pin behaviour across clang-format versions.  CI pins clang-format 22.1.5
# exactly (`pipx install "clang-format==22.1.5"` in ci.yml's clang-format job),
# but the LLVM default for Cpp11BracedListStyle has flipped between major versions
# (v14 vs v18+), which formats the `(alp_i2c_config_t){ .foo = ... }`
# designated-initialiser idiom differently.  Locking it explicitly keeps the output
# reproducible regardless of whichever clang-format a developer has on PATH.
Cpp11BracedListStyle: false
